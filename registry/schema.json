{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FreeGeo VPN Node Registry",
  "type": "object",
  "required": ["version", "updatedAt", "defaultCountry", "domainRoutes", "nodes"],
  "properties": {
    "version": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "defaultCountry": { "type": "string", "pattern": "^[a-z]{2}$" },
    "domainRoutes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["country", "domains"],
        "properties": {
          "country": { "type": "string", "pattern": "^[a-z]{2}$" },
          "domains": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "country", "flag", "name", "platform", "protocol",
          "host", "port", "uuid", "warp", "status"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "country": { "type": "string", "pattern": "^[a-z]{2}$" },
          "flag": { "type": "string" },
          "name": { "type": "string" },
          "platform": {
            "type": "string",
            "enum": ["serv00", "ct8", "koyeb", "render", "community", "vps"]
          },
          "protocol": {
            "type": "string",
            "enum": ["vless"]
          },
          "network": {
            "type": "string",
            "enum": ["tcp", "ws"],
            "default": "tcp"
          },
          "host": { "type": "string", "format": "hostname" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "path": { "type": "string" },
          "tls": {
            "type": "object",
            "properties": {
              "sni": { "type": "string" },
              "alpn": { "type": "array", "items": { "type": "string" } },
              "reality": {
                "type": "object",
                "required": ["pbk"],
                "properties": {
                  "pbk": { "type": "string" },
                  "sid": { "type": "string", "pattern": "^[0-9a-f]{0,16}$" },
                  "fp": { "type": "string", "default": "chrome" }
                }
              }
            }
          },
          "uuid": { "type": "string", "format": "uuid" },
          "warp": { "type": "boolean" },
          "status": {
            "type": "string",
            "enum": ["ok", "disabled", "new"]
          },
          "latencyMs": { "type": ["integer", "null"], "minimum": 0 },
          "bandwidth": {
            "type": "string",
            "enum": ["low", "high"],
            "default": "low"
          },
          "addedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
